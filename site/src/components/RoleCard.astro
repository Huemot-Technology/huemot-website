---
const { role, meta, rate, href = '/contact' } = Astro.props;
---
<a class="role reveal" href={href}>
  <span>
    <span class="role__t" style="display:block">{role}</span>
    <span class="role__m" style="display:block">{meta}</span>
  </span>
  <span style="display:flex;align-items:center;gap:12px">
    {rate && <span class="role__rate">{rate}</span>}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="width:18px;height:18px;color:var(--teal-deep)" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
  </span>
</a>
