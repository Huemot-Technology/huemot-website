---
// Embeds a real scheduling calendar. Renders nothing without a URL.
//
// This component originally shipped a static day/time picker as a stand-in,
// plus a two-step flow that swapped it for the ContactForm. Both are gone: the
// static slots were illustrative and booked nothing, so rendering them publicly
// would have advertised availability that does not exist (see LAUNCH-SCOPE.md).
//
// The site now links out to the scheduling page instead of embedding it — see
// BOOKING_URL in src/data/site.js. This component is kept, unused, for the day
// someone wants the calendar inline: set PUBLIC_HUEMOT_CALENDAR_URL and drop
// <BookingPicker /> onto the Contact page. A real calendar collects name and
// email itself, so the old two-step flow is not needed with it.
const CALENDAR_URL = import.meta.env.PUBLIC_HUEMOT_CALENDAR_URL || '';
---

{CALENDAR_URL && (
  <div class="card" style="padding:0;overflow:hidden">
    <iframe src={CALENDAR_URL} title="Book a discovery call" style="width:100%;height:640px;border:0;display:block"></iframe>
  </div>
)}
