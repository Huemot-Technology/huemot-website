---
// `id` is optional and omitted when unset, so existing callers render exactly as
// before. /industries uses it to expose anchor targets for the homepage links.
const { name, description, stats = [], href = '#', id } = Astro.props;
---
<a class="ind reveal" href={href} id={id}>
  <span class="ind__glow"></span>
  <span class="ind__t">{name}</span>
  <span class="ind__d" style="display:block">{description}</span>
  {stats.length > 0 && (
    <span class="ind__stats">
      {stats.map((s) => <span class="ind__stat"><b>{s.value}</b><span>{s.label}</span></span>)}
    </span>
  )}
</a>
