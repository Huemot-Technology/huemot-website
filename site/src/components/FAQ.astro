---
// FAQ accordion — every answer is drawn from already-approved facts (no new claims).
// Emits FAQPage structured data for rich results.
const faqs = [
  {
    q: 'How quickly can you get a team started?',
    a: 'From conversation to code in two weeks. Day 0–2 is discovery and scoping, Day 3–5 is team match and SOW, Day 6–10 is onboarding and access, and by Day 14 your pod runs sprint zero and starts building.',
  },
  {
    q: 'What engagement models do you offer?',
    a: 'Three. A Dedicated Pod is a ring-fenced team that works as an extension of yours — best for long-running products. A Managed Project is fixed-scope, fixed-outcome delivery with milestone billing. Staff Augmentation plugs specific skills into your existing team on demand.',
  },
  {
    q: 'Which technologies do you work with?',
    a: 'More than 50, across Microsoft, open source, Java, mobile, frontend, databases, cloud & infrastructure, AI & ML, CRM, ERP, e-commerce, and DevOps — delivered by pods that ship robust, scalable products.',
  },
  {
    q: 'Can I scale the team up or down?',
    a: 'Yes. A pre-vetted pool of 500+ engineers lets you spin a dedicated pod up — or down — within two weeks, with zero operational overhead.',
  },
  {
    q: 'How do you handle security and IP protection?',
    a: 'We are ISO 27001:2013 and ISO 9001:2015 certified, with strong NDAs, MSAs, and SLAs for secure IP creation, plus enterprise-grade data protection and secure access.',
  },
  {
    q: 'Where are you located?',
    a: 'Headquartered in Bhopal, India, with offices in the USA (Dover, DE) and Canada (Vancouver, BC) — serving 150+ enterprises across 15+ countries.',
  },
];

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<section class="section faq">
  <div class="container">
    <div class="section-head section-head--center reveal">
      <span class="eyebrow">FAQ</span>
      <h2 class="h2">Answers Before You Ask.</h2>
    </div>

    <div class="faq__list reveal">
      {faqs.map((f, i) => (
        <details class="faq__item" name="huemot-faq" open={i === 0}>
          <summary class="faq__q">
            <span>{f.q}</span>
            <svg class="faq__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
          </summary>
          <div class="faq__a"><p>{f.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(jsonld)} />

<style>
  .faq__list { max-width: 820px; margin-inline: auto; display: grid; gap: 14px; }
  .faq__item {
    background: var(--card); border: 1px solid var(--card-border);
    border-radius: var(--radius); box-shadow: var(--shadow-sm);
    overflow: hidden; transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .faq__item[open] { border-color: var(--card-border-strong); box-shadow: var(--shadow); }
  .faq__q {
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding: 20px clamp(18px, 3vw, 28px); cursor: pointer; list-style: none;
    font-family: var(--font-display); font-weight: 650; font-size: clamp(1.02rem, 1.6vw, 1.15rem);
    color: var(--ink); letter-spacing: -0.01em;
  }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__icon { width: 22px; height: 22px; color: var(--teal-deep); flex: none; transition: transform 0.25s ease; }
  .faq__item[open] .faq__icon { transform: rotate(180deg); }
  .faq__a { padding: 0 clamp(18px, 3vw, 28px) 22px; }
  .faq__a p { color: var(--body); line-height: 1.65; max-width: 68ch; }
  @media (prefers-reduced-motion: reduce) { .faq__icon { transition: none; } }
</style>
