---
// Sticky site header.
//
// The nav list is driven entirely by `site.js nav`. An item carrying a `mega`
// field grows a chevron and opens the matching panel in SiteMegaNav; items
// without one render as plain links, so adding or removing a dropdown is a data
// change, not a markup change.
//
// Careers is rendered twice on purpose, matching the design: as an external
// link beside the Contact button on desktop, and again inside the mobile panel
// (the desktop copy is hidden below 1040px, where the panel takes over).
import { nav, CAREERS_URL } from '../data/site.js';
import SiteMegaNav from './SiteMegaNav.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const hasMega = nav.some((item) => item.mega);
---

<header class="hdr" data-mega-root={hasMega ? '' : undefined}>
  <div class="container hdr__inner">
    <a href="/" class="brand" aria-label="Huemot Technology home">
      <img src="/brand/huemot-logo-trim.png" alt="Huemot Technology" width="52" height="52" class="brand__logo" />
    </a>

    <nav class="nav" aria-label="Primary">
      <ul class="nav__list">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={['nav__link', { 'is-active': !item.external && path === item.href }]}
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noopener noreferrer' : undefined}
              data-mega-trigger={item.mega}
              aria-expanded={item.mega ? 'false' : undefined}
            >
              {item.label}{item.mega && <svg class="nav__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="hdr__right">
      <a href={CAREERS_URL} target="_blank" rel="noopener noreferrer" class="hdr__careers">
        Careers
        <svg class="ext" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><path d="M15 3h6v6"/><path d="M10 14 21 3"/>
        </svg>
      </a>
      <a href="/contact" class="btn btn--primary hdr__cta">Contact</a>
      <button
        class="nav-toggle"
        data-nav-toggle
        type="button"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile panel. Carries data-nav-menu, so the existing toggle script in
       BaseLayout drives it unchanged. -->
  <div class="mobilenav" id="mobile-nav" data-nav-menu>
    <div class="container mobilenav__list">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={['mobilenav__link', { 'is-active': !item.external && path === item.href }]}
        >{item.label}</a>
      ))}
      <a href={CAREERS_URL} target="_blank" rel="noopener noreferrer" class="mobilenav__link mobilenav__link--last">
        Careers
        <svg class="ext" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><path d="M15 3h6v6"/><path d="M10 14 21 3"/>
        </svg>
      </a>
    </div>
  </div>

  <SiteMegaNav />
</header>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 90;
    background: rgba(247, 249, 248, 0.82);
    backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--card-border);
  }
  .hdr__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 78px;
  }
  .brand { display: inline-flex; align-items: center; }
  .brand__logo { width: auto; height: 52px; }

  .nav__list {
    display: flex;
    align-items: center;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 9px 11px;
    border-radius: 10px;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--ink);
    white-space: nowrap;
    transition: color var(--dur-fast) ease, background var(--dur-fast) ease;
  }
  .nav__link:hover { color: var(--teal-ink); background: var(--teal-wash); }
  .nav__link.is-active { color: var(--teal-ink); }

  .hdr__right { display: flex; align-items: center; gap: 10px; }
  .hdr__careers {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 9px 10px;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--body);
    white-space: nowrap;
    transition: color var(--dur-fast) ease;
  }
  .hdr__careers:hover { color: var(--teal-ink); }
  .ext { width: 13px; height: 13px; }
  .hdr__cta { padding: 0.6em 1.25em; font-size: 0.94rem; box-shadow: none; }

  .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    background: #fff;
    border: 1px solid var(--card-border);
    border-radius: 12px;
    color: var(--ink);
    cursor: pointer;
  }
  .nav-toggle svg { width: 20px; height: 20px; }

  /* Collapsed by default at every width; the media query below is what lets it
     open, so the panel can never appear on desktop. */
  .mobilenav {
    display: none;
    position: absolute;
    left: 0; right: 0; top: 100%;
    background: #fff;
    border-bottom: 1px solid var(--card-border);
    box-shadow: 0 30px 60px -30px rgba(15, 23, 42, 0.25);
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.28s ease;
  }
  .mobilenav__list { display: grid; gap: 4px; padding-block: 16px 24px; }
  .mobilenav__link {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 14px 12px;
    border-radius: 12px;
    font-size: 1.05rem;
    font-weight: 650;
    color: var(--ink);
  }
  .mobilenav__link:hover { background: var(--teal-wash); color: var(--teal-ink); }
  .mobilenav__link.is-active { color: var(--teal-ink); }
  .mobilenav__link--last {
    color: var(--body);
    border-top: 1px solid var(--card-border);
    margin-top: 6px;
    border-radius: 0 0 12px 12px;
  }

  @media (max-width: 1040px) {
    .nav { display: none; }
    .hdr__careers { display: none; }
    .nav-toggle { display: inline-flex; }
    .mobilenav { display: block; }
    .mobilenav.is-open {
      max-height: calc(100vh - 78px);
      overflow-y: auto;
    }
  }

  @media (max-width: 560px) {
    .brand__logo { height: 40px; }
  }
</style>
