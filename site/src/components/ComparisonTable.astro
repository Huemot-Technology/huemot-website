---
const { columns = [], rows = [], highlight = 2 } = Astro.props;
---
<div class="cmp-wrap">
  <table class="cmp">
    <thead>
      <tr>
        <th scope="col"><span class="sr-only">Dimension</span></th>
        {columns.map((c, i) => <th scope="col" class:list={[{ 'col-us': i === highlight - 1 }]}>{c}</th>)}
      </tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr>
          <th scope="row">{r.label}</th>
          {r.values.map((v, i) => <td class:list={[{ 'col-us': i === highlight - 1 }]}>{v}</td>)}
        </tr>
      ))}
    </tbody>
  </table>
</div>
