---
// Interior page hero.
//
// Two modes. Without `img` it renders the original light gradient-wash hero, so
// any caller that does not pass one is unchanged. With `img` it renders the
// dark photo hero used by Services, Case Studies, the industry pages and the
// practice pages — which is what stops the site reading as two different sites.
// Note: the space before `highlight` is written as a template literal. Inside
// the ternary below, JSX trims a bare leading space in the span, which ran the
// headline together as "procurementasks for.".
const {
  eyebrow,
  title,
  highlight = '',
  sub = '',
  img = '',        // path without the -800/-1600 suffix, e.g. /images/home/saas
  alt = '',
} = Astro.props;
---

{img ? (
  <section class="phero phero--photo">
    <img
      class="phero__bg"
      src={`${img}-1600.webp`}
      srcset={`${img}-800.webp 800w, ${img}-1600.webp 1600w`}
      sizes="100vw"
      alt={alt}
      width="1600" height="1067"
      loading="eager" fetchpriority="high" decoding="async"
    />
    <span class="phero__veil"></span>
    <div class="container phero__inner">
      {eyebrow && <span class="eyebrow phero__eyebrow">{eyebrow}</span>}
      <h1 class="h1 phero__title phero__title--photo">{title}{highlight && <span class="phero__accent">{` ${highlight}`}</span>}</h1>
      {sub && <p class="lead phero__sub phero__sub--photo">{sub}</p>}
      <div class="phero__slot"><slot /></div>
    </div>
  </section>
) : (
  <section class="phero hero-wash">
    <div class="container">
      {eyebrow && <span class="eyebrow rise rise-1">{eyebrow}</span>}
      <h1 class="h1 phero__title rise rise-2">{title}{highlight && <span class="teal">{` ${highlight}`}</span>}</h1>
      {sub && <p class="lead phero__sub rise rise-3">{sub}</p>}
      <div class="phero__slot rise rise-4"><slot /></div>
    </div>
  </section>
)}

<style>
  .phero {
    padding-block: clamp(56px, 8vw, 104px);
    border-bottom: 1px solid var(--card-border);
  }
  .phero__title { max-width: 18ch; margin-top: 8px; }
  .phero__sub { margin-top: 22px; max-width: 60ch; }
  .phero__slot:not(:empty) { margin-top: 30px; }

  /* ---- photo mode ---- */
  .phero--photo {
    position: relative; overflow: hidden;
    padding-block: 0; border-bottom: 0;
    background: var(--dark-bg); color: #fff;
  }
  .phero__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: .5; }
  .phero__veil {
    position: absolute; inset: 0;
    background: linear-gradient(90deg, rgba(15,23,42,.96) 0%, rgba(15,23,42,.82) 52%, rgba(15,23,42,.4) 100%);
  }
  .phero__inner { position: relative; padding-block: clamp(60px, 8vw, 112px) clamp(48px, 6vw, 84px); }
  .phero__eyebrow { color: var(--teal-bright); }
  .phero__title--photo {
    margin-top: 14px; max-width: 18ch; color: #fff;
    font-size: clamp(2.2rem, 4.2vw, 3.8rem); letter-spacing: -.03em; line-height: 1.04;
  }
  .phero__accent { color: var(--teal-bright); }
  .phero__sub--photo { color: rgba(255,255,255,.84); max-width: 58ch; }
  /* Chips and ghost buttons in the slot have to survive the dark ground. */
  .phero--photo :global(.chip) {
    background: rgba(255,255,255,.08); border-color: rgba(255,255,255,.22); color: #e8edf5;
  }
  .phero--photo :global(.btn--ghost) {
    background: transparent; border-color: rgba(255,255,255,.35); color: #fff; box-shadow: none;
  }
  .phero--photo :global(.btn--ghost:hover) { background: rgba(255,255,255,.1); border-color: rgba(255,255,255,.5); color: #fff; }
</style>
