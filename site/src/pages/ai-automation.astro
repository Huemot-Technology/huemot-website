---
// AI & Automation practice — /ai-automation.
// Content lives in data/practicePages.js; the body is the shared PracticePage
// layout so this page matches the industry pages rather than the old template.
import BaseLayout from '../layouts/BaseLayout.astro';
import PracticePage from '../components/PracticePage.astro';
import { practicePages } from '../data/practicePages.js';
import { seo } from '../data/site.js';

const practice = practicePages['ai-automation'];
---

<BaseLayout title={seo.ai.title} description={seo.ai.description}>
  <link
    slot="head"
    rel="preload"
    as="image"
    type="image/webp"
    href={`${practice.img}-1600.webp`}
    imagesrcset={`${practice.img}-800.webp 800w, ${practice.img}-1600.webp 1600w`}
    imagesizes="100vw"
    fetchpriority="high"
  />
  <PracticePage
    practice={practice}
    listTitle="What we build"
    listItems={practice.capabilities}
    secondary={{ title: 'Implementation highlights', items: practice.highlights }}
  />
</BaseLayout>
