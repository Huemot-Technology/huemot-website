---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PillButton from '../components/PillButton.astro';
import { seo, BOOKING_URL, BOOKING_EXTERNAL } from '../data/site.js';

const models = [
  { t: 'Dedicated Pod', d: 'A ring-fenced team that works as an extension of yours. Best for long-running products and roadmaps.' },
  { t: 'Managed Project', d: 'Fixed-scope, fixed-outcome delivery with milestone billing. Best for well-defined builds.' },
  { t: 'Staff Augmentation', d: 'Plug specific skills into your existing team on demand. Best for capacity and niche expertise.' },
];
const timeline = [
  { when: 'Day 0–2', what: 'Discovery & scoping' },
  { when: 'Day 3–5', what: 'Team match & SOW' },
  { when: 'Day 6–10', what: 'Onboarding & access' },
  { when: 'Day 14', what: 'Sprint zero — building' },
];
// What a buyer signs, in order. Reflects the sequence already described across
// the site (NDA, MSA, SOW, SLA) rather than introducing new terms.
const paperwork = [
  { n: 1, t: 'NDA', d: 'Before the first working session, so you can describe the actual problem rather than a sanitised version of it.' },
  { n: 2, t: 'MSA', d: 'The frame: IP assignment, confidentiality, data handling, liability, notice. Signed once, then every engagement hangs off it.' },
  { n: 3, t: 'SOW', d: 'Per engagement. Pod shape, named engineers, start date, rate, billing cadence and the SLA you are holding us to.' },
];

// Cost drivers, deliberately without numbers — the figure belongs in the SOW,
// but a buyer is entitled to know what moves it before booking a call.
const drivers = [
  { t: 'Pod shape', d: 'How many seats, and which roles. A discovery squad and a full delivery pod are different orders of cost.' },
  { t: 'Seniority mix', d: 'A pod is rarely uniform. The ratio of senior to mid engineers is usually the largest single lever.' },
  { t: 'Timezone overlap', d: 'Full India-hours delivery costs less than a team holding four hours of overlap with US Pacific.' },
  { t: 'Engagement length', d: 'A three-month build and a rolling annual pod are priced differently, because our own hiring risk differs.' },
  { t: 'Domain and compliance', d: 'Regulated work — lending, health data, payments — carries review overhead that has to be paid for somewhere.' },
];

const commercials = [
  { t: 'Dedicated Pod', d: 'Monthly, per seat, for the seats named in the SOW. Scale up from the same pre-vetted pool in two weeks; hand seats back on two weeks notice, with no penalty.' },
  { t: 'Managed Project', d: 'Fixed scope and fixed outcome, billed against milestones agreed in the SOW. Change requests are priced before they are started, not after.' },
  { t: 'Staff Augmentation', d: 'Monthly per engineer, with the same two weeks notice in either direction. Useful for a specific skill gap rather than a whole workstream.' },
];

const included = [
  'A named account owner, accountable under the SLA',
  'Sprint demos every two weeks, and a dashboard for velocity, defects and SLA compliance',
  'A monthly business review with your account owner',
  'Onboarding, environment access and security review inside the fourteen days',
  'Bench cover inside the pod, so one person leaving is not your problem',
];
const notIncluded = [
  'Third-party licences and cloud spend — billed at cost, or bought on your own accounts',
  'Travel, where you want people on site',
  'Work outside the SOW, which becomes a change request rather than a surprise',
];

const benefits = [
  { t: 'Talent', d: 'A global pool of 500+ pre-vetted professionals driving innovation at every step of your product lifecycle.' },
  { t: 'Infrastructure', d: 'Dedicated, branded, state-of-the-art facilities — 25,000 sq.ft across two development centers.' },
  { t: 'Security', d: 'ISO 27001:2013 and ISO 9001:2015 certified. Enterprise-grade data protection and secure access.' },
  { t: 'Legal & Accounts', d: 'Strong NDAs, MSAs, and SLAs for secure IP creation. Transparent billing and governance framework.' },
  { t: 'Support', d: 'Mature project management with Agile/Scrum. Dedicated account managers and SLA monitoring.' },
  { t: 'Scalability', d: 'Flexible, future-proof teams for evolving needs. Scale up or down within two weeks.' },
];
---

<BaseLayout title={seo.engage.title} description={seo.engage.description}>
  <link
    slot="head"
    rel="preload"
    as="image"
    type="image/webp"
    href="/images/home/standup-1600.webp"
    imagesrcset="/images/home/standup-800.webp 800w, /images/home/standup-1600.webp 1600w"
    imagesizes="100vw"
    fetchpriority="high"
  />

  <PageHero
    img="/images/home/standup"
    alt="Team in a standing meeting"
    eyebrow="How We Engage"
    title="From Conversation to Code in 2 Weeks."
    sub="Flexible commercial models and a fast, low-risk onboarding path."
  />

  <!-- Engagement models -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Engagement Models</span>
        <h2 class="h2">Three ways to work with us.</h2>
      </div>
      <div class="grid grid-3 stagger">
        {models.map((m) => (
          <article class="card card--hover model reveal">
            <h3 class="h3">{m.t}</h3>
            <p>{m.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Onboarding timeline -->
  <section class="section section--band">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Onboarding Timeline</span>
        <h2 class="h2">Two weeks, four steps.</h2>
      </div>
      <ol class="stepper stagger">
        {timeline.map((t, i) => (
          <li class="stepper__step reveal">
            <div class="stepper__node"><span>{i + 1}</span></div>
            <div class="stepper__body">
              <span class="stepper__when">{t.when}</span>
              <span class="stepper__what">{t.what}</span>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ODC -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">ODC On Demand</span>
        <h2 class="h2">Direct Benefits of a Dedicated, Branded Delivery Center.</h2>
      </div>
      <div class="grid grid-3 stagger">
        {benefits.map((b) => (
          <article class="card card--hover benefit reveal">
            <div class="benefit__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
            </div>
            <h3 class="h3">{b.t}</h3>
            <p>{b.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->

  <!-- ===== WHAT YOU SIGN ===== -->
  <section class="section">
    <div class="container">
      <span class="eyebrow">Paperwork</span>
      <h2 class="h2 eg__h2">What you sign, in order.</h2>
      <p class="lead eg__lead">Three documents, and none of them is a surprise. IP assignment sits in the MSA rather than in a later negotiation — the work is yours from the first commit.</p>
      <ol class="egseq stagger">
        {paperwork.map((x) => (
          <li class="egphase reveal">
            <span class="egphase__n">{x.n}</span>
            <div><b class="egphase__t">{x.t}</b><span class="egphase__d">{x.d}</span></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ===== COMMERCIALS ===== -->
  <section class="section section--band">
    <div class="container">
      <span class="eyebrow">Commercials</span>
      <h2 class="h2 eg__h2">How each model is billed.</h2>
      <div class="egcards stagger">
        {commercials.map((c) => (
          <div class="egcard reveal"><b class="egcard__t">{c.t}</b><span class="egcard__d">{c.d}</span></div>
        ))}
      </div>

      <div class="egsplit">
        <div class="reveal">
          <h3 class="egsplit__h">What the rate covers</h3>
          <ul class="eglist eglist--in">{included.map((i) => <li>{i}</li>)}</ul>
        </div>
        <div class="reveal">
          <h3 class="egsplit__h">What it does not</h3>
          <ul class="eglist eglist--out">{notIncluded.map((i) => <li>{i}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== COST DRIVERS ===== -->
  <section class="section">
    <div class="container">
      <span class="eyebrow">What moves the number</span>
      <h2 class="h2 eg__h2">Why we quote after the call, not before it.</h2>
      <p class="lead eg__lead">A rate card would be easy to publish and mostly wrong — the same headcount costs materially different amounts depending on the five things below. Tell us where you sit on them and you will have a number in the SOW, not a range that moves later.</p>
      <div class="egdrivers stagger">
        {drivers.map((d) => (
          <div class="egdriver reveal"><b class="egdriver__t">{d.t}</b><span class="egdriver__d">{d.d}</span></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--band text-center">
    <div class="container">
      <h2 class="h2">Let's map your first pod.</h2>
      <div style="margin-top:28px;display:flex;justify-content:center">
        <PillButton href={BOOKING_URL} external={BOOKING_EXTERNAL} variant="primary" size="lg">Book a Discovery Call</PillButton>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .eg__h2 { margin-top: 14px; }
  .eg__lead { margin-top: 16px; max-width: 62ch; }

  .egseq { list-style: none; margin: 30px 0 0; padding: 0; display: grid; gap: 12px; }
  .egphase { display: grid; grid-template-columns: 48px 1fr; gap: 18px; align-items: start;
    background: var(--card); border: 1px solid var(--card-border); border-radius: var(--radius); padding: 20px 22px; }
  .egphase__n { width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center;
    font-family: var(--font-display); font-weight: var(--fw-black); color: #fff; background: var(--teal-fill); }
  .egphase__t { display: block; font-family: var(--font-display); font-size: 1.05rem; letter-spacing: -.02em; color: var(--ink); }
  .egphase__d { display: block; margin-top: 5px; color: var(--body); font-size: .95rem; line-height: 1.55; }

  .egcards { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(12px, 1.6vw, 18px); margin-top: 30px; }
  .egcard { background: var(--card); border: 1px solid var(--card-border); border-radius: var(--radius); padding: 22px 24px; }
  .egcard__t { display: block; font-family: var(--font-display); font-size: 1.05rem; letter-spacing: -.02em; color: var(--ink); }
  .egcard__d { display: block; margin-top: 8px; color: var(--body); font-size: .93rem; line-height: 1.55; }

  .egsplit { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(28px, 4vw, 56px);
    margin-top: clamp(36px, 4vw, 52px); padding-top: 30px; border-top: 1px solid var(--card-border); }
  .egsplit__h { font-family: var(--font-display); font-size: 1.05rem; letter-spacing: -.02em; color: var(--ink); }
  .eglist { list-style: none; margin: 16px 0 0; padding: 0; display: grid; gap: 11px; }
  .eglist li { position: relative; padding-left: 28px; color: var(--body); font-size: .95rem; line-height: 1.5; }
  .eglist li::before { content: ''; position: absolute; left: 0; top: .42em; width: 15px; height: 15px; border-radius: 50%; }
  .eglist--in li::before { background: var(--teal-wash); box-shadow: inset 0 0 0 2px var(--teal); }
  .eglist--out li::before { background: #f1f3f6; box-shadow: inset 0 0 0 2px #b9c1cd; }

  .egdrivers { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(12px, 1.6vw, 18px); margin-top: 30px; }
  .egdriver { background: var(--card); border: 1px solid var(--card-border); border-radius: var(--radius); padding: 20px 22px; }
  .egdriver__t { display: block; font-family: var(--font-display); font-size: 1rem; letter-spacing: -.02em; color: var(--ink); }
  .egdriver__d { display: block; margin-top: 6px; color: var(--body); font-size: .92rem; line-height: 1.5; }

  @media (max-width: 900px) {
    .egcards, .egdrivers { grid-template-columns: 1fr; }
    .egsplit { grid-template-columns: 1fr; }
  }

  .model h3 { margin-bottom: 12px; }

  /* Connected stepper */
  .stepper {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px;
  }
  .stepper__step { position: relative; text-align: center; padding-top: 8px; }
  /* connecting line between nodes (desktop) */
  .stepper__step::before {
    content: ''; position: absolute; top: 34px; left: 50%; width: 100%; height: 3px;
    background: linear-gradient(90deg, var(--teal), var(--teal-wash-2));
    z-index: 0;
  }
  .stepper__step:last-child::before { display: none; }
  .stepper__node {
    position: relative; z-index: 1;
    width: 56px; height: 56px; margin: 0 auto 18px; border-radius: 50%;
    display: grid; place-items: center;
    font-family: var(--font-display); font-weight: 800; font-size: 1.3rem; color: #fff;
    background: var(--teal-fill);
    box-shadow: var(--shadow-teal);
    border: 4px solid var(--bg-alt);
  }
  .stepper__when { display: block; font-weight: 800; color: var(--teal-deep); font-size: 1.05rem; margin-bottom: 6px; }
  .stepper__what { color: var(--ink-soft); font-weight: 550; }
  @media (max-width: 720px) {
    .stepper { grid-template-columns: 1fr; gap: 0; }
    .stepper__step { display: grid; grid-template-columns: 56px 1fr; gap: 18px; align-items: start; padding: 0 0 28px; }
    .stepper__node { margin: 0; }
    .stepper__body { padding-top: 6px; }
    /* vertical connecting line */
    .stepper__step::before {
      top: 56px; left: 27px; width: 3px; height: 100%;
      background: linear-gradient(180deg, var(--teal), var(--teal-wash-2));
    }
  }

  .benefit__icon {
    width: 44px; height: 44px; border-radius: 12px; margin-bottom: 16px;
    display: grid; place-items: center; color: var(--teal-deep);
    background: var(--teal-wash); border: 1px solid var(--teal-wash-2);
  }
  .benefit__icon svg { width: 22px; height: 22px; }
  .benefit h3 { margin-bottom: 10px; }
</style>
