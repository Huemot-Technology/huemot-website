---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import { seo, offices, contact } from '../data/site.js';
---

<BaseLayout title={seo.contact.title} description={seo.contact.description}>
  <PageHero
    eyebrow="Let's Build Together"
    title="Ready to Scale Your Engineering — On Demand?"
    sub="Book a 30-minute discovery call. We'll map your goals to a pod and a plan — and have a team building within two weeks."
  />

  <section class="section">
    <div class="container contact-grid stagger">
      <!-- Form -->
      <div class="contact-form-col reveal">
        <ContactForm />
      </div>

      <!-- Offices + emails -->
      <aside class="contact-aside reveal">
        <span class="eyebrow">Our Offices</span>
        <div class="offices">
          {offices.map((o) => (
            <div class="office">
              <div class="office__top">
                <span class="office__flag">{o.flag}</span>
                <div>
                  <h3 class="office__country">{o.country}</h3>
                  <p class="office__city">{o.city}</p>
                </div>
              </div>
              <p class="office__addr">{o.address}</p>
              <a class="office__phone" href={`tel:${o.phone.replace(/[^+\d]/g, '')}`}>{o.phone}</a>
            </div>
          ))}
        </div>
        <div class="contact-emails">
          <a href={`mailto:${contact.email}`}>{contact.email}</a>
          <a href={`mailto:${contact.careersEmail}`}>{contact.careersEmail}</a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: clamp(28px, 4vw, 52px); align-items: start; }
  @media (max-width: 900px) { .contact-grid { grid-template-columns: 1fr; } }

  .contact-aside .eyebrow { margin-bottom: 20px; }
  .offices { display: grid; gap: 16px; }
  .office {
    background: var(--card); border: 1px solid var(--card-border);
    border-radius: var(--radius); box-shadow: var(--shadow-sm); padding: 22px 24px;
  }
  .office__top { display: flex; gap: 14px; align-items: center; margin-bottom: 12px; }
  .office__flag { font-size: 1.7rem; line-height: 1; }
  .office__country { font-size: 1.08rem; }
  .office__city { color: var(--muted); font-size: 0.88rem; margin-top: 2px; }
  .office__addr { color: var(--body); line-height: 1.5; font-size: 0.95rem; }
  .office__phone { display: inline-block; margin-top: 12px; font-weight: 650; color: var(--teal-deep); }

  .contact-emails { display: flex; flex-direction: column; gap: 8px; margin-top: 24px; }
  .contact-emails a { color: var(--teal-deep); font-weight: 650; }
</style>
