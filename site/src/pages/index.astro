---
// Homepage — photo-led redesign per design_handoff_huemot_site/MarketingPage.dc.html.
//
// Route notes:
//  - Tiles and cards deep-link into /services and /case-studies, which carry the
//    matching ids; the industries grid links to /industries#<sector>.
//  - The design's second Featured card points at an Insights article that does
//    not exist (/insights is withheld under LAUNCH_SCOPE='reduced'), so it goes
//    to /ai-automation as the handoff suggests. Flagged as SAMPLE content.
//  - The "Hire Developers" card keeps /hire-developers rather than the
//    prototype's /services#team-augmentation — the route map sanctions it and it
//    is the fuller page for that intent.
import BaseLayout from '../layouts/BaseLayout.astro';
import PillButton from '../components/PillButton.astro';
import StatCounter from '../components/StatCounter.astro';
import SectionHead from '../components/SectionHead.astro';
import DarkBand from '../components/DarkBand.astro';
import { seo, BOOKING_URL, BOOKING_EXTERNAL } from '../data/site.js';

const bandStats = [
  { value: 500, suffix: '+', label: 'Engineers', tone: 'teal' },
  { value: 50, suffix: '+', label: 'Technology Stacks', tone: 'blue' },
  { value: 150, suffix: '+', label: 'Clients', tone: 'purple' },
  { value: 90, suffix: '%', label: 'Client Retention', tone: 'pink' },
  { value: 15, suffix: '+', label: 'Countries', tone: 'amber' },
];

const featured = [
  {
    kind: 'Case Study',
    title: '25M+ Shipments. 99.99% Uptime.',
    body: "How a 25-member pod re-architected ShipFlow's monolith into microservices on Kubernetes — without a single missed peak season.",
    href: '/case-studies#shipflow',
    img: 'port',
    alt: 'Container port at dusk',
  },
  {
    kind: 'AI & Automation',
    title: 'AI-Native Pods, Not AI-Assisted Staffing.',
    body: "What changes when every engineer on the team ships with Gen-AI tooling from sprint zero — and what doesn't.",
    href: '/ai-automation',
    img: 'circuit',
    alt: 'Close-up of a circuit board',
  },
  {
    kind: 'Hire Developers',
    title: 'Two Weeks, Four Steps.',
    body: 'Pick the roles, the stack and the timezone. We match a pre-vetted pod and run sprint zero by Day 14.',
    href: '/hire-developers',
    img: 'working-session',
    alt: 'Team in a working session around a table',
  },
];

// Each tile deep-links to its offering on /services, which carries matching ids.
const engageTiles = [
  { t: 'Team Augmentation', d: 'Battle-tested engineers across 50+ stacks. Agile and on demand — zero operational overhead.', href: '/services#team-augmentation' },
  { t: 'Product Engineering', d: 'Full-cycle product development from ideation to launch, run by Agile Pods.', href: '/services#product-engineering' },
  { t: 'Digital Transformation', d: 'Consulting, optimization and automation powered by AI and Gen-AI.', href: '/services#digital-transformation' },
  { t: 'Managed Services', d: 'SLA-driven 24x7 support and governance that runs business-as-usual.', href: '/services#managed-services' },
];

const sectors = [
  { eyebrow: 'Healthcare', title: 'HIPAA-Ready Patient Platforms.', img: 'healthcare', alt: 'Clinician reviewing records on a tablet', href: '/industries/healthcare' },
  { eyebrow: 'Fintech & Banking', title: 'Payments and Lending at Scale.', img: 'fintech', alt: 'Trading charts on screens', href: '/industries/fintech' },
  { eyebrow: 'Retail & E-Commerce', title: 'Storefronts, OMS and Personalization.', img: 'retail', alt: 'Contactless payment at a retail checkout', href: '/industries/retail' },
  { eyebrow: 'SaaS & Platforms', title: 'Multi-Tenant, Multi-Region, Always On.', img: 'saas', alt: 'Global network lit up over the earth at night', href: '/industries/saas' },
];

const caseMetrics = [
  { value: 45, suffix: '%', label: 'Faster Load', tone: 'teal' },
  { value: 3.2, suffix: 'x', label: 'Throughput', tone: 'blue' },
  { value: 3.4, prefix: '$', suffix: 'M', label: 'Cost Saved', tone: 'purple' },
  { value: 99.99, suffix: '%', label: 'Uptime', tone: 'pink' },
];

const steps = [
  { when: 'Day 0–2', t: 'Discovery & scoping', d: 'Goals, constraints and the outcomes that matter.' },
  { when: 'Day 3–5', t: 'Team match & SOW', d: 'Pre-vetted engineers matched on stack, domain and timezone.' },
  { when: 'Day 6–10', t: 'Onboarding & access', d: 'Environments, repos and rituals — set up before kickoff.' },
  { when: 'Day 14', t: 'Sprint zero — building', d: 'The pod ships its first increment.' },
];

const pod = [
  { i: 'PM', label: 'Product Mgr' },
  { i: 'FE', label: 'React' },
  { i: 'AI', label: 'ML Eng' },
  { i: 'QA', label: 'QA' },
];

const allocation = [
  { site: 'WMS-West · 12,480 parcels' },
  { site: 'ATL-Sorting · 9,112 parcels' },
  { site: 'ORD-Delivery · 7,905 parcels' },
];
---

<BaseLayout title={seo.home.title} description={seo.home.description}>
  <!-- LCP is the first hero tile; preload it so it is not discovered late. -->
  <link
    slot="head"
    rel="preload"
    as="image"
    type="image/webp"
    href="/images/home/pod-laptop-800.webp"
    imagesrcset="/images/home/pod-laptop-800.webp 800w, /images/home/pod-laptop-1600.webp 1600w"
    imagesizes="(max-width: 900px) 45vw, 420px"
    fetchpriority="high"
  />

  <!-- ===== HERO ===== -->
  <section class="hhero">
    <div class="container hhero__grid">
      <div>
        <h1 class="h1 hhero__title rise rise-1">Your Next Release Is Already <span class="teal">Staffed.</span></h1>
        <p class="lead hhero__lead rise rise-2">
          500+ engineers across 50+ stacks, assembled into a pod that ships from day one. From
          conversation to code in two weeks — that's our promise.
        </p>
        <div class="hhero__cta rise rise-3">
          <PillButton href={BOOKING_URL} external={BOOKING_EXTERNAL} variant="primary" size="lg">Book a Discovery Call</PillButton>
          <PillButton href="#work" variant="ghost" size="lg" arrow={false}>See the Work</PillButton>
        </div>
        <p class="hhero__trust rise rise-4">
          Trusted by <strong>150+</strong> enterprises across <strong>15+</strong> countries ·
          <strong>90%</strong> retention
        </p>
      </div>

      <div class="collage rise rise-3">
        <div class="collage__tile collage__tile--a">
          <img
            src="/images/home/pod-laptop-800.webp"
            srcset="/images/home/pod-laptop-800.webp 800w, /images/home/pod-laptop-1600.webp 1600w"
            sizes="(max-width: 900px) 45vw, 420px"
            alt="Engineering pod working around a laptop"
            width="800" height="534"
            loading="eager" fetchpriority="high" decoding="async"
          />
        </div>
        <div class="collage__tile collage__tile--b">
          <img
            src="/images/home/datacenter-800.webp"
            srcset="/images/home/datacenter-800.webp 800w, /images/home/datacenter-1600.webp 1600w"
            sizes="(max-width: 900px) 45vw, 300px"
            alt="Data center corridor"
            width="800" height="449"
            loading="eager" decoding="async"
          />
        </div>

        <div class="fcard collage__sprint">
          <div class="fcard__row">
            <b class="fcard__t">Sprint zero</b>
            <span class="fcard__day">Day 14</span>
          </div>
          <div class="sprint__track">
            <span class="sprint__fill" data-sprint-fill></span>
          </div>
          <div class="sprint__scale"><span>Day 0</span><span>Day 7</span><span>Day 14</span></div>
        </div>

        <div class="fcard collage__pod">
          <div class="fcard__row">
            <span class="fcard__eyebrow">Your pod</span>
            <span class="livepill"><span class="livepill__dot"></span>Live</span>
          </div>
          <div class="podgrid">
            {pod.map((p) => (
              <span class="podgrid__row">
                <span class="podgrid__av">{p.i}</span>{p.label}
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== FEATURED ===== -->
  <section class="hfeat">
    <div class="container">
      <div class="hfeat__head reveal">
        <h2 class="h2 hfeat__h2">Featured.</h2>
      </div>
      <div class="hfeat__grid stagger">
        {featured.map((f) => (
          <a href={f.href} class="fcardlink reveal">
            <span class="fcardlink__shot">
              <img
                src={`/images/home/${f.img}-800.webp`}
                srcset={`/images/home/${f.img}-800.webp 800w, /images/home/${f.img}-1600.webp 1600w`}
                sizes="(max-width: 560px) 90vw, (max-width: 900px) 45vw, 373px"
                alt={f.alt}
                width="800" height="534"
                loading="lazy" decoding="async"
              />
            </span>
            <span class="fcardlink__body">
              <span class="fcardlink__kind">{f.kind}</span>
              <b class="fcardlink__t">{f.title}</b>
              <span class="fcardlink__d">{f.body}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== STAT BAND ===== -->
  <DarkBand style="padding-block:clamp(44px,5vw,64px)">
    <div class="container">
      <div class="hstats reveal">
        {bandStats.map((s) => <StatCounter {...s} />)}
      </div>
    </div>
  </DarkBand>

  <!-- ===== WHAT WE DO ===== -->
  <section class="section hwwd" id="services">
    <div class="container hwwd__grid">
      <div class="hwwd__figure reveal">
        <div class="hwwd__shot">
          <img
            src="/images/home/engineer-code-800.webp"
            srcset="/images/home/engineer-code-800.webp 800w, /images/home/engineer-code-1600.webp 1600w"
            sizes="(max-width: 900px) 90vw, 500px"
            alt="Engineer reviewing code on a monitor"
            width="800" height="534"
            loading="lazy" decoding="async"
          />
        </div>
        <div class="hwwd__float">
          <span class="hwwd__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          </span>
          <span>
            <b class="hwwd__big">2 weeks</b>
            <span class="hwwd__small">to sprint zero</span>
          </span>
        </div>
      </div>

      <div class="reveal">
        <span class="eyebrow">What We Do</span>
        <h2 class="h2 hwwd__h2">Built to Out-Execute, Not Just Out-Staff.</h2>
        <p class="lead hwwd__lead">
          You get a cohesive, accountable team — not a stack of resumes. Four ways to engage, one
          standard of delivery.
        </p>
        <div class="hwwd__tiles">
          {engageTiles.map((x) => (
            <a href={x.href} class="etile">
              <b class="etile__t">{x.t}</b>
              <span class="etile__d">{x.d}</span>
            </a>
          ))}
        </div>
        <div class="hwwd__btn">
          <PillButton href="/services" variant="ghost">Explore All Services</PillButton>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== INDUSTRIES ===== -->
  <section class="section section--band" id="industries">
    <div class="container">
      <div class="hind__head">
        <SectionHead
          eyebrow="Industries"
          title="Domain Depth. Not Just Headcount."
          lead="Pods that already know your regulations, your peak seasons and your integrations."
        />
        <a href="/industries" class="link-arrow hind__all reveal">All industries
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>

      <div class="indgrid stagger">
        <a href="/industries/logistics" class="indtile indtile--lead reveal">
          <img
            src="/images/home/logistics-800.webp"
            srcset="/images/home/logistics-800.webp 800w, /images/home/logistics-1600.webp 1600w"
            sizes="(max-width: 900px) 96vw, 520px"
            alt="Warehouse shelves stacked with parcels"
            width="800" height="533"
            loading="lazy" decoding="async"
          />
          <span class="indtile__veil"></span>
          <span class="indtile__copy">
            <span class="indtile__eyebrow">Logistics &amp; Supply Chain</span>
            <b class="indtile__t indtile__t--lead">25M+ Shipments a Month. Real-Time Courier Allocation.</b>
            <span class="indtile__d">Fleet, WMS and last-mile platforms built for peak season.</span>
          </span>
        </a>

        {sectors.map((s) => (
          <a href={s.href} class="indtile reveal">
            <img
              src={`/images/home/${s.img}-800.webp`}
              srcset={`/images/home/${s.img}-800.webp 800w, /images/home/${s.img}-1600.webp 1600w`}
              sizes="(max-width: 900px) 48vw, 300px"
              alt={s.alt}
              width="800" height="533"
              loading="lazy" decoding="async"
            />
            <span class="indtile__veil"></span>
            <span class="indtile__copy">
              <span class="indtile__eyebrow">{s.eyebrow}</span>
              <b class="indtile__t">{s.title}</b>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== FEATURED CASE STUDY =====
       DarkBand only forwards class/style, so the #work anchor lives on a
       wrapper rather than changing a component five other pages render. -->
  <div id="work">
  <DarkBand>
    <div class="container hcase__grid">
      <div class="reveal">
        <span class="eyebrow">Featured Case Study</span>
        <h2 class="h2 hcase__h2">Logistics Platform Re-Architecture.</h2>
        <p class="hcase__sub">ShipFlow — E-Commerce Logistics SaaS</p>
        <p class="lead hcase__lead">
          A legacy monolith had to scale to 25M+ monthly shipments under a 99.9% uptime SLA. A
          25-member pod ran a phased migration to Kubernetes, added real-time courier allocation and
          ML-powered rate selection.
        </p>
        <div class="hcase__stats">
          {caseMetrics.map((m) => <StatCounter {...m} />)}
        </div>
        <div class="hcase__btn">
          <PillButton href="/case-studies#shipflow" variant="primary">Read the Case Study</PillButton>
        </div>
      </div>

      <div class="hcase__figure reveal">
        <div class="hcase__shot">
          <img
            src="/images/home/port-800.webp"
            srcset="/images/home/port-800.webp 800w, /images/home/port-1600.webp 1600w"
            sizes="(max-width: 900px) 90vw, 540px"
            alt="Shipping containers stacked at a port"
            width="800" height="534"
            loading="lazy" decoding="async"
          />
        </div>
        <div class="fcard hcase__float">
          <div class="fcard__row">
            <b class="fcard__t">Courier allocation</b>
            <span class="livepill"><span class="livepill__dot"></span>Live</span>
          </div>
          <div class="alloc">
            {allocation.map((a) => (
              <div class="alloc__row"><span>{a.site}</span><span class="alloc__ok">Ready</span></div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </DarkBand>
  </div>

  <!-- ===== OUR PROCESS ===== -->
  <section class="section hproc">
    <div class="container hproc__grid">
      <div class="reveal">
        <span class="eyebrow">Our Process</span>
        <h2 class="h2 hproc__h2">From Conversation to Code in Two Weeks.</h2>
        <p class="lead hproc__lead">
          No months-long procurement cycle. Four steps, fourteen days, and a ring-fenced pod that
          stays with you.
        </p>
        <ol class="hsteps">
          {steps.map((s) => (
            <li class="hsteps__row">
              <span class="hsteps__when">{s.when}</span>
              <span>
                <b class="hsteps__t">{s.t}</b>
                <span class="hsteps__d">{s.d}</span>
              </span>
            </li>
          ))}
        </ol>
        <div class="hproc__btn">
          <PillButton href="/process" variant="ghost">See How We Engage</PillButton>
        </div>
      </div>

      <div class="trio reveal">
        <div class="trio__tall">
          <img
            src="/images/home/pairing-800.webp"
            srcset="/images/home/pairing-800.webp 800w, /images/home/pairing-1600.webp 1600w"
            sizes="(max-width: 900px) 45vw, 280px"
            alt="Two engineers pairing at a desk"
            width="800" height="533"
            loading="lazy" decoding="async"
          />
        </div>
        <div class="trio__cell trio__cell--top">
          <img
            src="/images/home/code-screen-800.webp"
            srcset="/images/home/code-screen-800.webp 800w, /images/home/code-screen-1600.webp 1600w"
            sizes="(max-width: 900px) 45vw, 280px"
            alt="Code on a laptop screen"
            width="800" height="533"
            loading="lazy" decoding="async"
          />
        </div>
        <div class="trio__cell trio__cell--bottom">
          <img
            src="/images/home/standup-800.webp"
            srcset="/images/home/standup-800.webp 800w, /images/home/standup-1600.webp 1600w"
            sizes="(max-width: 900px) 45vw, 280px"
            alt="Team in a standing meeting"
            width="800" height="525"
            loading="lazy" decoding="async"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ===== QUOTE =====
       The handoff's quote is a design-file sample it flags as unconfirmed, so
       this keeps the testimonial already published on huemot.com instead of
       putting new words in a named client's mouth. -->

  <section class="section section--band">
    <div class="container hquote__wrap">
      <figure class="quote reveal">
        <svg class="quote__mark" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M9.5 6C6.5 7.5 5 10 5 13v5h5v-6H7.5c0-1.8.9-3.2 3-4.2L9.5 6Zm9 0c-3 1.5-4.5 4-4.5 7v5h5v-6h-2.5c0-1.8.9-3.2 3-4.2L18.5 6Z"/></svg>
        <blockquote>
          Huemot didn't just deliver engineers — they delivered outcomes. Their pod embedded with our
          team, owned the roadmap, and the platform they rebuilt is now the backbone of our business.
        </blockquote>
        <figcaption><strong>Arjun Nair</strong> — VP Engineering, ShipFlow</figcaption>
      </figure>
    </div>
  </section>

  <!-- ===== FINAL CTA ===== -->
  <section class="cta-band" id="contact">
    <div class="container">
      <div class="cta-band__card hero-wash reveal">
        <span class="eyebrow">Let's Build Together</span>
        <h2 class="h2">Ready to Scale Your Engineering — On Demand?</h2>
        <p class="lead hcta__lead">
          Book a 30-minute discovery call. We'll map your goals to a pod and a plan — and have a team
          building within two weeks.
        </p>
        <div class="cta-band__actions">
          <PillButton href={BOOKING_URL} external={BOOKING_EXTERNAL} variant="primary" size="lg">Book a Discovery Call</PillButton>
        </div>
        <p class="cta-band__links">
          <a href="mailto:info@huemot.com">info@huemot.com</a>
          <span aria-hidden="true">·</span>
          <a href="tel:+917553138975">+91 755 313 8975</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Sprint-zero bar: 8% -> 100%, 400ms after load. Under reduced motion it is
  // painted complete with no transition rather than animating.
  const fill = document.querySelector('[data-sprint-fill]');
  if (fill) {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      fill.style.transition = 'none';
      fill.style.width = '100%';
    } else {
      setTimeout(() => { fill.style.width = '100%'; }, 400);
    }
  }
</script>

<style>
  /* Page-scoped: Astro emits these only in the homepage bundle, so no other
     route's CSS changes. Shared tokens/utilities come from global.css. */

  /* ---------- Hero ---------- */
  .hhero { background: #fff; padding-block: clamp(56px, 7vw, 104px) clamp(48px, 6vw, 88px); }
  .hhero__grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 5vw, 64px); align-items: center; }
  .hhero__title { font-size: clamp(2.4rem, 4.4vw, 4rem); letter-spacing: -.03em; line-height: 1.02; }
  .hhero__lead { margin-top: 26px; max-width: 46ch; }
  .hhero__cta { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 34px; }
  .hhero__trust { margin-top: 28px; color: var(--muted); font-size: .95rem; }
  .hhero__trust strong { color: var(--teal-deep); }

  .collage { position: relative; height: clamp(420px, 40vw, 540px); }
  .collage__tile { position: absolute; overflow: hidden; box-shadow: var(--shadow-lg); }
  .collage__tile img { width: 100%; height: 100%; object-fit: cover; }
  .collage__tile--a { top: 0; right: 0; width: 70%; height: 58%; border-radius: 24px 24px 24px 96px; }
  .collage__tile--b { bottom: 8%; left: 0; width: 50%; height: 44%; border-radius: 96px 24px 24px 24px; }

  /* Floating white UI cards, shared by the hero and the case-study band. */
  .fcard { background: #fff; border: 1px solid var(--card-border); border-radius: var(--radius); box-shadow: var(--shadow-lg); padding: 14px 16px; }
  .fcard__row { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .fcard__t { font-family: var(--font-display); font-size: .88rem; letter-spacing: -.02em; color: var(--ink); }
  .fcard__day { font-size: .7rem; font-weight: var(--fw-bold); color: var(--teal-deep); white-space: nowrap; }
  .fcard__eyebrow { font-size: .66rem; font-weight: var(--fw-bold); letter-spacing: .14em; text-transform: uppercase; color: var(--muted); white-space: nowrap; }

  .collage__sprint { position: absolute; left: 0; top: 14%; width: 40%; min-width: 190px; }
  .collage__pod { position: absolute; right: 0; bottom: 0; width: 46%; min-width: 210px; }

  .sprint__track { margin-top: 10px; height: 6px; border-radius: var(--radius-pill); background: var(--bg-alt); overflow: hidden; }
  .sprint__fill { display: block; width: 8%; height: 100%; border-radius: var(--radius-pill); background: linear-gradient(90deg, var(--teal-deep), var(--teal-bright)); transition: width 1.4s var(--ease-out-expo); }
  .sprint__scale { display: flex; justify-content: space-between; margin-top: 8px; font-size: .66rem; color: var(--muted); }

  .livepill { display: inline-flex; align-items: center; gap: 6px; padding: 3px 8px; border-radius: var(--radius-pill); background: var(--teal-wash); color: var(--teal-ink); font-size: .64rem; font-weight: var(--fw-bold); letter-spacing: .1em; text-transform: uppercase; white-space: nowrap; }
  .livepill__dot { width: 6px; height: 6px; border-radius: 50%; background: var(--teal); }

  .podgrid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 10px; margin-top: 12px; }
  .podgrid__row { display: flex; align-items: center; gap: 8px; font-size: .76rem; font-weight: 600; color: var(--ink-soft); white-space: nowrap; }
  .podgrid__av { flex: none; width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center; font-size: .54rem; font-weight: var(--fw-black); color: #fff; background: var(--teal-fill); }

  /* ---------- Featured ---------- */
  .hfeat { background: var(--bg); border-top: 1px solid var(--card-border); padding-block: clamp(48px, 6vw, 80px); }
  .hfeat__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; margin-bottom: 28px; }
