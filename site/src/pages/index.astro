---
import BaseLayout from '../layouts/BaseLayout.astro';
import PillButton from '../components/PillButton.astro';
import StatCounter from '../components/StatCounter.astro';
import Marquee from '../components/Marquee.astro';
import FAQ from '../components/FAQ.astro';
import { seo, credentials } from '../data/site.js';

const heroStats = [
  { value: 500, suffix: '+', label: 'Engineers', tone: 'teal' },
  { value: 150, suffix: '+', label: 'Clients', tone: 'blue' },
  { value: 90, suffix: '%', label: 'Client Retention', tone: 'purple' },
  { value: 15, suffix: '+', label: 'Countries', tone: 'pink' },
  { value: 3, suffix: '', label: 'Global Offices', tone: 'amber' },
];

const why = [
  {
    t: 'AI-Native Delivery',
    d: 'Gen-AI and automation are wired into how we build — not bolted on. Faster cycles, fewer defects, lower cost-to-serve.',
  },
  {
    t: 'Scale in 2 Weeks',
    d: 'A pre-vetted talent pool of 500+ engineers. Spin a dedicated pod up — or down — within two weeks, with zero operational overhead.',
  },
  {
    t: '90% Client Retention',
    d: 'Clients stay because outcomes compound. Dedicated account ownership, SLA-driven governance, and a customer-success-first DNA.',
  },
  {
    t: 'Outcome-Owned Pods',
    d: 'You get a cohesive, accountable team — not a stack of resumes. Product thinking, agile pods, and measurable business results.',
  },
];

const doo = [
  {
    t: 'Team Augmentation',
    d: 'Dedicated, battle-tested teams across 50+ stacks to supercharge your development. Agile and on demand — zero operational overhead.',
  },
  {
    t: 'Product Engineering',
    d: 'End-to-end, full-cycle product development from ideation to launch. Unique Agile Pods that ship robust, scalable, intuitive products.',
  },
  {
    t: 'Digital Transformation',
    d: 'Unlock value with consulting, optimization, and automation powered by AI and Gen-AI. Helping enterprises thrive in modern ecosystems.',
  },
  {
    t: 'Managed Services',
    d: 'SLA-driven IMS to run business-as-usual. 24x7 support, governance, and deep technology expertise that optimizes processes and cuts cost.',
  },
];

const caseMetrics = [
  { value: 45, suffix: '%', label: 'Faster Load', tone: 'teal' },
  { value: 3.2, suffix: 'x', label: 'Throughput', tone: 'blue' },
  { value: 3.4, prefix: '$', suffix: 'M', label: 'Cost Saved', tone: 'purple' },
  { value: 99.99, suffix: '%', label: 'Uptime', tone: 'pink' },
];
---

<BaseLayout title={seo.home.title} description={seo.home.description}>
  <!-- ===================== HERO ===================== -->
  <section class="hero hero-wash">
    <div class="container hero__grid">
      <div class="hero__left">
        <span class="badge rise rise-1"><span class="dot"></span>Agile on Demand</span>
        <h1 class="h1 hero__title rise rise-2">
          AI-Led Software Development &amp;
          <span class="teal">Digital Transformation.</span>
        </h1>
        <p class="lead hero__sub rise rise-3">
          Enterprise solutions, staff augmentation, and end-to-end product
          engineering — delivered by 500+ engineers across 50+ technology stacks.
        </p>
        <div class="hero__cta rise rise-4">
          <PillButton href="/contact" variant="primary" size="lg">Book a Discovery Call</PillButton>
          <PillButton href="/services" variant="ghost" size="lg" arrow={false}>Explore Our Services</PillButton>
        </div>
        <p class="hero__trust rise rise-5">
          Trusted by <strong>150+</strong> enterprises across <strong>15+</strong> countries.
        </p>
      </div>

      <!-- Floating snapshot card -->
      <aside class="hero__card rise rise-3" aria-label="Engagement snapshot">
        <div class="hcard__head">
          <span class="eyebrow" style="margin:0">Pod Snapshot</span>
          <span class="badge"><span class="dot"></span>Live pool</span>
        </div>
        <div class="hcard__stats">
          <div><b>500+</b><span>Engineers</span></div>
          <div><b>50+</b><span>Stacks</span></div>
          <div><b>90%</b><span>Retention</span></div>
        </div>
        <hr class="divider" />
        <p class="hcard__label">From conversation to code</p>
        <ul class="hcard__steps">
          <li><span class="hcard__day">Day 0–2</span> Discovery &amp; scoping</li>
          <li><span class="hcard__day">Day 6–10</span> Onboarding &amp; access</li>
          <li><span class="hcard__day">Day 14</span> Sprint zero — building</li>
        </ul>
      </aside>
    </div>
  </section>

  <!-- ===================== STATS BAR ===================== -->
  <section class="stats-bar" aria-label="Company at a glance">
    <div class="container">
      <div class="stats-bar__grid">
        {heroStats.map((s) => <StatCounter {...s} />)}
      </div>
    </div>
  </section>

  <!-- ===================== WHY HUEMOT ===================== -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Why Huemot</span>
        <h2 class="h2">Built to Out-Execute, Not Just Out-Staff.</h2>
        <p class="lead" style="margin-top:16px">What makes us different from the other 10,000 offshore shops.</p>
      </div>
      <div class="grid grid-4 stagger">
        {why.map((c, i) => (
          <article class="card card--hover why-card reveal">
            <span class="why-card__n">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="h3">{c.t}</h3>
            <p>{c.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== WHAT WE DO ===================== -->
  <section class="section section--band">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">What We Do</span>
        <h2 class="h2">Your Digital Factory. 500+ Engineers.</h2>
      </div>
      <div class="grid grid-2 stagger">
        {doo.map((c) => (
          <article class="card card--hover do-card reveal">
            <div class="do-card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
            </div>
            <div>
              <h3 class="h3">{c.t}</h3>
              <p>{c.d}</p>
            </div>
          </article>
        ))}
      </div>
      <div class="do-link">
        <a href="/services" class="link-arrow">See all services
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ===================== FEATURED CASE STUDY ===================== -->
  <section class="section">
    <div class="container">
      <article class="card feature reveal">
        <div class="feature__body">
          <span class="eyebrow">Proven Impact</span>
          <h2 class="h2">25M+ Shipments. 99.99% Uptime.</h2>
          <p class="lead" style="margin-top:16px">
            ShipFlow, an e-commerce logistics SaaS, needed to scale a legacy
            monolith into microservices without missing a beat. Our 25-member
            agile pod delivered a phased Kubernetes migration with real-time
            courier allocation and ML-powered rate selection.
          </p>
          <a href="/case-studies" class="link-arrow" style="margin-top:24px">Read all case studies
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>
        <div class="feature__metrics">
          {caseMetrics.map((m) => <StatCounter {...m} />)}
        </div>
      </article>
    </div>
  </section>

  <!-- ===================== TESTIMONIAL ===================== -->
  <section class="section section--band">
    <div class="container">
      <figure class="quote reveal">
        <svg class="quote__mark" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M9.5 6C6.5 7.5 5 10 5 13v5h5v-6H7.5c0-1.8.9-3.2 3-4.2L9.5 6Zm9 0c-3 1.5-4.5 4-4.5 7v5h5v-6h-2.5c0-1.8.9-3.2 3-4.2L18.5 6Z"/></svg>
        <blockquote>
          Huemot didn't just deliver engineers — they delivered outcomes. Their
          pod embedded with our team, owned the roadmap, and the platform they
          rebuilt is now the backbone of our business.
        </blockquote>
        <figcaption><strong>Arjun Nair</strong> — VP Engineering, ShipFlow</figcaption>
      </figure>
    </div>
  </section>

  <!-- ===================== CREDENTIALS ===================== -->
  <section class="section creds">
    <div class="container">
      <p class="creds__label reveal">Certified &amp; partnered with</p>
      <div class="reveal"><Marquee items={credentials} speed={34} /></div>
    </div>
  </section>

  <!-- ===================== FAQ ===================== -->
  <div class="section--band"><FAQ /></div>

  <!-- ===================== FINAL CTA ===================== -->
  <section class="cta-band">
    <div class="container">
      <div class="cta-band__card hero-wash reveal">
        <span class="eyebrow">Let's Build Together</span>
        <h2 class="h2">Ready to scale your engineering — on demand?</h2>
        <p class="lead" style="margin-top:16px;max-width:60ch;margin-inline:auto">
          Book a 30-minute discovery call. We'll map your goals to a pod and a
          plan — and have a team building within two weeks.
        </p>
        <div class="cta-band__actions">
          <PillButton href="/contact" variant="primary" size="lg">Book a Discovery Call</PillButton>
        </div>
        <p class="cta-band__links">
          <a href="mailto:info@huemot.com">info@huemot.com</a>
          <span aria-hidden="true">·</span>
          <a href="tel:+917553138975">+91 755 313 8975</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero { padding-block: clamp(64px, 9vw, 128px); border-bottom: 1px solid var(--card-border); }
  .hero__grid {
    position: relative; z-index: 1;
    display: grid; grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(32px, 5vw, 72px); align-items: center;
  }
  .hero__title { margin-top: 20px; }
  .hero__sub { margin-top: 24px; max-width: 54ch; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 34px; }
  .hero__trust { margin-top: 26px; color: var(--muted); font-size: 0.98rem; }
  .hero__trust strong { color: var(--teal-deep); }

  /* Floating snapshot card */
  .hero__card {
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(10px);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: clamp(22px, 2.6vw, 30px);
  }
  .hcard__head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22px; }
  .hcard__stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; text-align: center; }
  .hcard__stats b {
    display: block; font-family: var(--font-display); font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800; letter-spacing: -0.03em; color: var(--ink);
  }
  .hcard__stats span { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  .hcard__label {
    font-size: 0.72rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--muted); margin: 18px 0 14px;
  }
  .hcard__steps { list-style: none; margin: 0; padding: 0; }
  .hcard__steps li {
    display: flex; align-items: baseline; gap: 12px; padding: 9px 0;
    font-size: 0.95rem; color: var(--ink-soft); border-top: 1px solid var(--card-border);
  }
  .hcard__steps li:first-child { border-top: 0; }
  .hcard__day { flex: none; width: 74px; font-weight: 700; color: var(--teal-deep); font-size: 0.85rem; }

  @media (max-width: 900px) {
    .hero__grid { grid-template-columns: 1fr; }
    .hero__card { max-width: 460px; }
  }

  /* Stats bar */
  .stats-bar { padding-block: clamp(36px, 5vw, 56px); border-bottom: 1px solid var(--card-border); background: #fff; }
  .stats-bar__grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 24px; }
  @media (max-width: 800px) { .stats-bar__grid { grid-template-columns: repeat(3, 1fr); row-gap: 32px; } }
  @media (max-width: 460px) { .stats-bar__grid { grid-template-columns: repeat(2, 1fr); } }

  /* Why cards */
  .why-card__n {
    display: inline-block; font-size: 0.85rem; font-weight: 800; letter-spacing: 0.1em;
    color: var(--teal-deep); background: var(--teal-wash);
    width: 38px; height: 38px; line-height: 38px; text-align: center;
    border-radius: 10px; margin-bottom: 18px;
  }
  .why-card h3 { margin-bottom: 10px; }

  /* Do cards */
  .do-card { display: flex; gap: 18px; align-items: flex-start; }
  .do-card__icon {
    flex: none; width: 46px; height: 46px; border-radius: 12px;
    display: grid; place-items: center; color: var(--teal-deep);
    background: var(--teal-wash); border: 1px solid var(--teal-wash-2);
  }
  .do-card__icon svg { width: 24px; height: 24px; }
  .do-card h3 { margin-bottom: 8px; }
  .do-link { margin-top: 32px; }

  .link-arrow {
    display: inline-flex; align-items: center; gap: 8px;
    font-weight: 650; color: var(--teal-deep);
  }
  .link-arrow svg { width: 18px; height: 18px; transition: transform 0.18s ease; }
  .link-arrow:hover svg { transform: translateX(4px); }

  /* Feature case study */
  .feature {
    display: grid; grid-template-columns: 1.35fr 1fr; gap: clamp(28px, 4vw, 56px);
    align-items: center; padding: clamp(28px, 4vw, 52px);
  }
  .feature__metrics {
    display: grid; grid-template-columns: 1fr 1fr; gap: 28px 20px;
    background: var(--bg); border: 1px solid var(--card-border);
    border-radius: var(--radius); padding: clamp(24px, 3vw, 36px);
  }
  @media (max-width: 820px) { .feature { grid-template-columns: 1fr; } }

  /* Quote */
  .quote { max-width: 860px; margin-inline: auto; text-align: center; }
  .quote__mark { width: 44px; height: 44px; color: var(--teal); margin-inline: auto; }
  .quote blockquote {
    margin: 18px 0 22px; font-size: clamp(1.3rem, 2.6vw, 1.9rem);
    font-weight: 600; line-height: 1.4; color: var(--ink); letter-spacing: -0.01em;
  }
  .quote figcaption { color: var(--body); font-size: 1.02rem; }
  .quote figcaption strong { color: var(--ink); }

  /* Credentials */
  .creds { padding-block: clamp(48px, 6vw, 72px); }
  .creds__label {
    text-align: center; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--muted); margin-bottom: 24px;
  }
  .creds__row { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }

  /* Final CTA */
  .cta-band { padding-block: 0 clamp(64px, 8vw, 100px); }
  .cta-band__card {
    text-align: center; border: 1px solid var(--card-border);
    border-radius: var(--radius-lg); padding: clamp(44px, 7vw, 88px) var(--gutter);
    box-shadow: var(--shadow);
  }
  .cta-band__actions { margin-top: 30px; display: flex; justify-content: center; }
  .cta-band__links { margin-top: 22px; color: var(--muted); font-size: 0.95rem; }
  .cta-band__links a { color: var(--teal-deep); font-weight: 600; }
  .cta-band__links span { margin-inline: 10px; }
</style>
