---
// v2 home page. This REPLACES the current index.astro — diff before overwriting.
import BaseLayout from '../layouts/BaseLayout.astro';
import PillButton from '../components/PillButton.astro';
import StatCounter from '../components/StatCounter.astro';
import Marquee from '../components/Marquee.astro';
import FAQ from '../components/FAQ.astro';
import SectionHead from '../components/SectionHead.astro';
import DarkBand from '../components/DarkBand.astro';
import HeroPodVisual from '../components/HeroPodVisual.astro';
import AwardsStrip from '../components/AwardsStrip.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import IndustryCard from '../components/IndustryCard.astro';
import PodConfigurator from '../components/PodConfigurator.astro';
import ProcessTimeline from '../components/ProcessTimeline.astro';
import InsightCard from '../components/InsightCard.astro';
import { seo, credentials, BOOKING_URL, BOOKING_EXTERNAL } from '../data/site.js';
import { industries, comparison, process as processSteps, insights, awards, FULL } from '../data/content.js';

const heroStats = [
  { value: 500, suffix: '+', label: 'Engineers', tone: 'teal' },
  { value: 150, suffix: '+', label: 'Clients', tone: 'blue' },
  { value: 90, suffix: '%', label: 'Client Retention', tone: 'purple' },
  { value: 15, suffix: '+', label: 'Countries', tone: 'pink' },
  { value: 3, suffix: '', label: 'Global Offices', tone: 'amber' },
];
const why = [
  { t: 'AI-Native Delivery', d: 'Gen-AI and automation are wired into how we build — not bolted on. Faster cycles, fewer defects, lower cost-to-serve.' },
  { t: 'Scale in 2 Weeks', d: 'A pre-vetted talent pool of 500+ engineers. Spin a dedicated pod up — or down — within two weeks, with zero operational overhead.' },
  { t: '90% Client Retention', d: 'Clients stay because outcomes compound. Dedicated account ownership, SLA-driven governance, and a customer-success-first DNA.' },
  { t: 'Outcome-Owned Pods', d: 'You get a cohesive, accountable team — not a stack of resumes. Product thinking, agile pods, and measurable business results.' },
];
const doo = [
  { t: 'Team Augmentation', d: 'Dedicated, battle-tested teams across 50+ stacks to supercharge your development. Agile and on demand — zero operational overhead.' },
  { t: 'Product Engineering', d: 'End-to-end, full-cycle product development from ideation to launch. Unique Agile Pods that ship robust, scalable, intuitive products.' },
  { t: 'Digital Transformation', d: 'Unlock value with consulting, optimization, and automation powered by AI and Gen-AI. Helping enterprises thrive in modern ecosystems.' },
  { t: 'Managed Services', d: 'SLA-driven IMS to run business-as-usual. 24x7 support, governance, and deep technology expertise that optimizes processes and cuts cost.' },
];
const caseMetrics = [
  { value: 45, suffix: '%', label: 'Faster Load', tone: 'teal' },
  { value: 3.2, suffix: 'x', label: 'Throughput', tone: 'blue' },
  { value: 3.4, prefix: '$', suffix: 'M', label: 'Cost Saved', tone: 'purple' },
  { value: 99.99, suffix: '%', label: 'Uptime', tone: 'pink' },
];
---

<BaseLayout title={seo.home.title} description={seo.home.description}>
  <!-- HERO -->
  <section class="hero hero-wash">
    <div class="container hero__grid">
      <div class="hero__left">
        <span class="badge rise rise-1"><span class="dot"></span>Agile on Demand</span>
        <h1 class="h1 hero__title rise rise-2">Ship faster with a pod that <span class="teal">already knows how.</span></h1>
        <p class="lead hero__sub rise rise-3">
          AI-led product engineering, staff augmentation and digital transformation — delivered by
          500+ engineers across 50+ technology stacks. From conversation to code in two weeks.
        </p>
        <div class="hero__cta rise rise-4">
          <PillButton href={BOOKING_URL} external={BOOKING_EXTERNAL} variant="primary" size="lg">Book a Discovery Call</PillButton>
          <PillButton href="/hire-developers" variant="ghost" size="lg" arrow={false}>Hire Developers</PillButton>
        </div>
        <p class="hero__trust rise rise-5">
          Trusted by <strong>150+</strong> enterprises across <strong>15+</strong> countries.
        </p>
      </div>

      <aside class="hero__card rise rise-3" aria-label="Your pod, assembling">
        <div class="hcard__head">
          <span class="eyebrow" style="margin:0">Your pod, assembling</span>
          <span class="badge"><span class="dot"></span>Live pool</span>
        </div>
        <HeroPodVisual />
        <hr class="divider" style="margin:20px 0 0" />
        <p class="hcard__label">From conversation to code</p>
        <ul class="hcard__steps">
          <li><span class="hcard__day">Day 0–2</span> Discovery &amp; scoping</li>
          <li><span class="hcard__day">Day 6–10</span> Onboarding &amp; access</li>
          <li><span class="hcard__day">Day 14</span> Sprint zero — building</li>
        </ul>
      </aside>
    </div>
  </section>

  <!-- CREDENTIALS — certifications are ours to display; client marks are not -->
  <section class="logo-band">
    <div class="container">
      <p class="creds__label">Certified &amp; partnered with</p>
      <Marquee items={credentials} speed={34} />
    </div>
  </section>

  <!-- DARK: STATS + COMPARISON -->
  <DarkBand style="padding-block:clamp(56px,7vw,96px)">
    <div class="container">
      <div class="stats-bar__grid reveal">
        {heroStats.map((s) => <StatCounter {...s} />)}
      </div>
      <div style="margin-top:64px">
        <div class="cmp-head reveal">
          <div style="max-width:46ch">
            <span class="eyebrow">The Honest Comparison</span>
            <h2 class="h2">Hiring is slow. A pod is not.</h2>
            <p class="lead" style="margin-top:16px">
              Filling a specialist role takes months — sourcing, notice periods, ramp-up. Our pods
              are writing code on day fourteen — with a named owner, an SLA, and the option to hand
              the seats back.
            </p>
          </div>
          <PillButton href="/process" variant="primary">See how we engage</PillButton>
        </div>
        <div class="reveal"><ComparisonTable columns={comparison.columns} rows={comparison.rows} highlight={2} /></div>
      </div>
    </div>
  </DarkBand>

  <!-- WHY -->
  <section class="section">
    <div class="container">
      <SectionHead eyebrow="Why Huemot" title="Built to Out-Execute, Not Just Out-Staff." lead="What makes us different from the other 10,000 offshore shops." />
      <div class="grid grid-4 stagger">
        {why.map((c, i) => (
          <article class="card card--hover why-card reveal">
            <span class="why-card__n">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="h3">{c.t}</h3>
            <p>{c.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section section--band">
    <div class="container">
      <SectionHead eyebrow="What We Do" title="Your Digital Factory. 500+ Engineers." />
      <div class="grid grid-2 stagger">
        {doo.map((c) => (
          <article class="card card--hover do-card reveal">
            <div class="do-card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
            </div>
            <div><h3 class="h3">{c.t}</h3><p>{c.d}</p></div>
          </article>
        ))}
      </div>
      <div style="margin-top:32px">
        <a href="/services" class="link-arrow">See all services
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- INDUSTRIES -->
  <section class="section">
    <div class="container">
      <SectionHead eyebrow="Industries" title="Domain fluency, not just delivery." lead="We have shipped in these markets before — the regulations, the integrations and the failure modes are not new to us." />
      <div class="grid grid-3 stagger">
        {industries.slice(0, 3).map((i) => <IndustryCard {...i} href="/industries" />)}
      </div>
      <div style="margin-top:32px">
        <a href="/industries" class="link-arrow">All six industries
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- POD CONFIGURATOR -->
  <section class="section section--band">
    <div class="container">
      <SectionHead eyebrow="Build Your Pod" title="Pick a shape. See the team." lead="Every pod is drawn from the same pre-vetted pool and ships with a named account owner." />
      <PodConfigurator />
    </div>
  </section>

  <!-- PROCESS PREVIEW -->
  <section class="section">
    <div class="container process-split">
      <div class="reveal">
        <span class="eyebrow">How We Engage</span>
        <h2 class="h2">Two weeks, six moves.</h2>
        <p class="lead" style="margin-top:16px">No discovery theatre, no bench-warming. Here is exactly what happens between the first call and your first merged pull request.</p>
        <div style="margin-top:26px"><PillButton href="/process" variant="ghost">Read the full process</PillButton></div>
      </div>
      <ProcessTimeline steps={processSteps.slice(0, 4)} />
    </div>
  </section>

  <!-- DARK: FEATURED CASE -->
  <DarkBand>
    <div class="container">
      <div class="reveal">
        <span class="eyebrow">Proven Impact</span>
        <h2 class="h2" style="max-width:16ch">25M+ Shipments. 99.99% Uptime.</h2>
        <p class="lead" style="margin-top:18px;max-width:62ch">
          ShipFlow needed to scale a legacy monolith into microservices without missing a beat. Our
          25-member agile pod delivered a phased Kubernetes migration with real-time courier
          allocation and ML-powered rate selection.
        </p>
      </div>
      <div class="grid grid-4 reveal" style="margin-top:40px">
        {caseMetrics.map((m) => <StatCounter {...m} />)}
      </div>
      <div style="margin-top:36px;display:flex;gap:14px;flex-wrap:wrap">
        <PillButton href="/case-studies" variant="primary">Read the case study</PillButton>
      </div>
      <figure class="quote" style="margin-top:56px">
        <svg class="quote__mark" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M9.5 6C6.5 7.5 5 10 5 13v5h5v-6H7.5c0-1.8.9-3.2 3-4.2L9.5 6Zm9 0c-3 1.5-4.5 4-4.5 7v5h5v-6h-2.5c0-1.8.9-3.2 3-4.2L18.5 6Z"/></svg>
        <blockquote>
          Huemot didn't just deliver engineers — they delivered outcomes. Their pod embedded with our
          team, owned the roadmap, and the platform they rebuilt is now the backbone of our business.
        </blockquote>
        <figcaption><strong>Arjun Nair</strong> — VP Engineering, ShipFlow</figcaption>
      </figure>
    </div>
  </DarkBand>

  <!-- INSIGHTS — withheld until real posts exist (LAUNCH_SCOPE) -->
  {FULL && (
    <section class="section">
      <div class="container">
        <SectionHead eyebrow="Insights" title="What we have learned, written down." />
        <div class="grid grid-3 stagger">
          {insights.slice(0, 3).map((x) => <InsightCard {...x} href="/insights" />)}
        </div>
        <div style="margin-top:32px">
          <a href="/insights" class="link-arrow">All insights
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- RECOGNITION — withheld until real awards exist (LAUNCH_SCOPE) -->
  {FULL && (
    <section class="section section--band">
      <div class="container">
        <p class="creds__label">Recognition</p>
        <div class="reveal"><AwardsStrip items={awards} /></div>
      </div>
    </section>
  )}

  <!-- FAQ -->
  <div class="section--band"><FAQ /></div>

  <!-- FINAL CTA -->
  <section class="cta-band">
    <div class="container">
      <div class="cta-band__card hero-wash reveal">
        <span class="eyebrow">Let's Build Together</span>
        <h2 class="h2">Ready to scale your engineering — on demand?</h2>
        <p class="lead" style="margin-top:16px;max-width:60ch;margin-inline:auto">
          Book a 30-minute discovery call. We'll map your goals to a pod and a plan — and have a team
          building within two weeks.
        </p>
        <div class="cta-band__actions">
          <PillButton href={BOOKING_URL} external={BOOKING_EXTERNAL} variant="primary" size="lg">Book a Discovery Call</PillButton>
        </div>
        <p class="cta-band__links">
          <a href="mailto:info@huemot.com">info@huemot.com</a>
          <span aria-hidden="true">·</span>
          <a href="tel:+917553138975">+91 755 313 8975</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding-block: clamp(64px, 9vw, 128px); border-bottom: 1px solid var(--card-border); }
  .hero__grid { position: relative; z-index: 1; display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(32px, 5vw, 72px); align-items: center; }
  .hero__title { margin-top: 20px; }
  .hero__sub { margin-top: 24px; max-width: 54ch; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 34px; }
  .hero__trust { margin-top: 26px; color: var(--muted); font-size: .98rem; }
  .hero__trust strong { color: var(--teal-deep); }
  .hero__card { background: rgba(255,255,255,.82); backdrop-filter: blur(10px); border: 1px solid var(--card-border); border-radius: var(--radius-lg); box-shadow: var(--shadow-lg); padding: clamp(22px, 2.6vw, 30px); }
  .hcard__head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22px; }
  .hcard__label { font-size: .72rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); margin: 18px 0 14px; }
  .hcard__steps { list-style: none; margin: 0; padding: 0; }
  .hcard__steps li { display: flex; align-items: baseline; gap: 12px; padding: 9px 0; font-size: .95rem; color: var(--ink-soft); border-top: 1px solid var(--card-border); }
  .hcard__steps li:first-child { border-top: 0; }
  .hcard__day { flex: none; width: 74px; font-weight: 700; color: var(--teal-deep); font-size: .85rem; }

  .logo-band { background: #fff; border-bottom: 1px solid var(--card-border); padding-block: 34px; }
  .creds__label { text-align: center; font-size: .78rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); margin-bottom: 24px; }
  .band-dark .creds__label { color: var(--dark-muted); }

  .stats-bar__grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 24px; }
  .cmp-head { display: flex; flex-wrap: wrap; gap: clamp(20px, 4vw, 56px); align-items: flex-end; justify-content: space-between; margin-bottom: 32px; }
  .process-split { display: grid; grid-template-columns: .85fr 1.15fr; gap: clamp(28px, 5vw, 72px); align-items: start; }

  .why-card__n { display: inline-block; font-size: .85rem; font-weight: 800; letter-spacing: .1em; color: var(--teal-deep); background: var(--teal-wash); width: 38px; height: 38px; line-height: 38px; text-align: center; border-radius: 10px; margin-bottom: 18px; }
  .why-card h3 { margin-bottom: 10px; }
  .quote { max-width: 860px; margin-inline: auto; text-align: center; }
  .quote__mark { width: 44px; height: 44px; color: var(--teal); margin-inline: auto; }
  .quote blockquote { margin: 18px 0 22px; font-size: clamp(1.3rem, 2.6vw, 1.9rem); font-weight: 600; line-height: 1.4; color: var(--ink); letter-spacing: -.01em; }
  .quote figcaption { color: var(--body); font-size: 1.02rem; }
  .quote figcaption strong { color: var(--ink); }
  .cta-band { padding-block: 0 clamp(64px, 8vw, 100px); }

  @media (max-width: 900px) {
    .hero__grid { grid-template-columns: 1fr; }
    .hero__card { max-width: 520px; }
    .stats-bar__grid { grid-template-columns: repeat(3, 1fr); row-gap: 32px; }
    .process-split { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) { .stats-bar__grid { grid-template-columns: repeat(2, 1fr); } }
</style>
