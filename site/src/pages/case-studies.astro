---
// Case Studies — per design_handoff_huemot_site/CaseStudies.dc.html.
//
// Study ids (shipflow, lendbridge, assureiq, mediloop) are the anchor targets
// the homepage links to. Cards alternate image side; below 900px the image
// always sits on top.
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import StatCounter from '../components/StatCounter.astro';
import Quote from '../components/Quote.astro';
import CTABand from '../components/CTABand.astro';
import { seo } from '../data/site.js';
import { caseStudies as studies } from '../data/caseStudies.js';


const clientele = [
  { group: 'Fintech & Financial', names: ['PayNova', 'LendBridge', 'FinPay', 'KredFlow', 'OpenLedger', 'AssureIQ'] },
  { group: 'SaaS & Productivity', names: ['BillStack', 'FlowGuide', 'EngageIQ', 'LeadOrbit', 'TaskNest', 'PeoplePoint'] },
  { group: 'Healthtech', names: ['CareGrid', 'MediLoop', 'VitaTrack', 'ScanAI', 'HomeCarePlus', 'SwiftClinic'] },
  { group: 'Supply Chain & Manufacturing', names: ['AgriSense', 'FarmEdge', 'FactoryAI', 'StockSync', 'AuthentiQ', 'RetailPulse'] },
  { group: 'Retail & E-commerce', names: ['ShipFlow', 'CheckoutX', 'StoreForge', 'QuickCart', 'ReachGrow', 'AdPilot'] },
];
---

<BaseLayout title={seo.cases.title} description={seo.cases.description}>
  <link
    slot="head"
    rel="preload"
    as="image"
    type="image/webp"
    href="/images/home/port-1600.webp"
    imagesrcset="/images/home/port-800.webp 800w, /images/home/port-1600.webp 1600w"
    imagesizes="100vw"
    fetchpriority="high"
  />

  <!-- ===== DARK PHOTO HERO ===== -->
  <section class="cshero">
    <img
      class="cshero__bg"
      src="/images/home/port-1600.webp"
      srcset="/images/home/port-800.webp 800w, /images/home/port-1600.webp 1600w"
      sizes="100vw"
      alt="Container port at dusk"
      width="1600" height="1067"
      loading="eager" fetchpriority="high" decoding="async"
    />
    <span class="cshero__veil"></span>
    <div class="container cshero__inner">
      <span class="eyebrow cshero__eyebrow">Case Studies</span>
      <h1 class="h1 cshero__title">Delivering Measurable <span class="cshero__accent">Impact.</span></h1>
      <p class="lead cshero__lead">
        Real outcomes across logistics, lending, insurtech and digital health — each one shipped by a
        ring-fenced pod.
      </p>
    </div>
  </section>

  <!-- ===== STUDIES ===== -->
  <section class="section cs-list">
    <div class="container cs-list__stack">
      {studies.map((s, i) => (
        <article class="cs reveal" id={s.id}>
          <div class:list={['cs__media', { 'cs__media--right': i % 2 === 1 }]}>
            <img
              src={`${s.img}-800.webp`}
              srcset={`${s.img}-800.webp 800w, ${s.img}-1600.webp 1600w`}
              sizes="(max-width: 900px) 100vw, 600px"
              alt={s.alt}
              width="800" height="533"
              loading="lazy" decoding="async"
            />
            <span class="cs__sector">{s.sector}</span>
          </div>
          <div class="cs__body">
            <span class="cs__n">Case Study {i + 1}</span>
            <h2 class="h2 cs__title">{s.title}</h2>
            <p class="cs__client">{s.client}</p>
            <div class="cs__cols">
              <div>
                <h3 class="cs__label">Challenge</h3>
                <p class="cs__text">{s.challenge}</p>
              </div>
              <div>
                <h3 class="cs__label">Solution</h3>
                <p class="cs__text">{s.solution}</p>
              </div>
            </div>
            <div class="cs__metrics">
              {s.metrics.map((m) => <StatCounter {...m} />)}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- ===== CLIENTELE ===== -->
  <section class="section section--band">
    <div class="container">
      <SectionHead
        eyebrow="Selected Clientele"
        title="150+ Clients. 90% Retention."
        lead="Trusted by high-growth product companies across fintech, SaaS, healthtech, supply chain and retail."
      />
      <div class="clientele stagger">
        {clientele.map((c) => (
          <div class="cgroup reveal">
            <h3 class="cgroup__t">{c.group}</h3>
            <div class="cgroup__chips">
              {c.names.map((n) => <span class="chip">{n}</span>)}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== QUOTE — see the handoff's SAMPLE list; wording matches the
       testimonial already published on the site. ===== -->
  <section class="section cs-quote">
    <div class="container cs-quote__wrap">
      <Quote author="Arjun Nair" role="VP Engineering, ShipFlow">
        Huemot didn't just deliver engineers — they delivered outcomes. Their pod embedded with our
        team, owned the roadmap, and the platform they rebuilt is now the backbone of our business.
      </Quote>
    </div>
  </section>

  <CTABand
    title="Your Outcome Could Be Next."
    lead="Book a 30-minute discovery call. We'll map your goals to a pod and a plan."
  />
</BaseLayout>

<style>
  /* ---------- Dark photo hero ---------- */
  .cshero { position: relative; overflow: hidden; background: var(--dark-bg); color: #fff; }
  .cshero__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: .5; }
  .cshero__veil {
    position: absolute; inset: 0;
    background: linear-gradient(90deg, rgba(15,23,42,.96) 0%, rgba(15,23,42,.8) 50%, rgba(15,23,42,.35) 100%);
  }
  .cshero__inner { position: relative; padding-block: clamp(72px, 9vw, 128px) clamp(56px, 7vw, 96px); }
  .cshero__eyebrow { color: var(--teal-bright); }
  .cshero__title {
    margin-top: 16px; max-width: 14ch; color: #fff;
    font-size: clamp(2.4rem, 4.6vw, 4.2rem); letter-spacing: -.03em; line-height: 1.02;
  }
  .cshero__accent { color: var(--teal-bright); }
  .cshero__lead { margin-top: 22px; max-width: 46ch; color: rgba(255,255,255,.82); }

  /* ---------- Studies ---------- */
  .cs-list { background: #fff; }
  .cs-list__stack { display: grid; gap: clamp(24px, 3vw, 40px); }
  .cs {
    display: grid; grid-template-columns: 1fr 1fr;
    background: var(--card); border: 1px solid var(--card-border);
    border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow);
    scroll-margin-top: 96px;
  }
  .cs__media { position: relative; min-height: 420px; }
  /* Alternate the image side on wide screens only. */
  .cs__media--right { order: 2; }
  .cs__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .cs__sector {
    position: absolute; left: 22px; top: 22px;
    display: inline-flex; align-items: center; gap: 6px;
    font-size: .7rem; font-weight: var(--fw-bold); letter-spacing: var(--ls-label);
    text-transform: uppercase; color: var(--teal-ink);
    background: #fff; padding: 6px 12px; border-radius: var(--radius-pill); box-shadow: var(--shadow);
  }
  .cs__body { padding: clamp(28px, 4vw, 48px); }
  .cs__n {
    display: inline-block; font-size: .72rem; font-weight: var(--fw-bold);
    letter-spacing: var(--ls-label); text-transform: uppercase;
    color: var(--teal-ink); background: var(--teal-wash);
    padding: 5px 11px; border-radius: var(--radius-pill);
  }
  .cs__title { margin-top: 14px; font-size: clamp(1.6rem, 2.6vw, 2.2rem); }
  .cs__client { margin-top: 10px; color: var(--teal-deep); font-weight: var(--fw-semibold); }
  .cs__cols { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(20px, 2.5vw, 32px); margin-top: 24px; }
  .cs__label {
    font-size: .78rem; font-weight: var(--fw-bold); letter-spacing: var(--ls-label);
    text-transform: uppercase; color: var(--muted);
  }
  .cs__text { margin-top: 10px; color: var(--body); line-height: 1.6; font-size: .95rem; }
  .cs__metrics {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px 14px;
    margin-top: 28px; padding-top: 24px; border-top: 1px solid var(--card-border);
  }

  /* ---------- Clientele ---------- */
  .clientele { display: grid; gap: 26px; margin-top: 34px; }
  .cgroup {
    display: grid; grid-template-columns: minmax(160px, 220px) 1fr; gap: 16px;
    align-items: start; padding-top: 18px; border-top: 1px solid var(--card-border);
  }
  .cgroup__t { font-size: .85rem; font-weight: var(--fw-bold); letter-spacing: .06em; color: var(--ink); padding-top: 6px; }
  .cgroup__chips { display: flex; flex-wrap: wrap; gap: 10px; }

  /* ---------- Quote ---------- */
  .cs-quote { background: #fff; }
  .cs-quote__wrap { max-width: 880px; }

  /* ---------- Breakpoints ---------- */
  @media (max-width: 900px) {
    .cs { grid-template-columns: 1fr; }
    /* Image always leads once stacked, whichever side it took on desktop. */
    .cs__media, .cs__media--right { order: 0; min-height: 0; aspect-ratio: 16 / 9; }
    .cs__cols { grid-template-columns: 1fr; }
    .cs__metrics { grid-template-columns: 1fr 1fr; }
    .cgroup { grid-template-columns: 1fr; }
  }
</style>
