---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import DarkBand from '../components/DarkBand.astro';
import RoleCard from '../components/RoleCard.astro';
import PodConfigurator from '../components/PodConfigurator.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import TechRadar from '../components/TechRadar.astro';
import PillButton from '../components/PillButton.astro';
import { roles, comparison, radar } from '../data/content.js';
---

<BaseLayout
  title="Hire Developers | Named Engineers in 2 Weeks | Huemot"
  description="Hire pre-vetted React, Node, Java, .NET, mobile, AI/ML, DevOps and Salesforce engineers. Named engineers from a pool of 500+, building in two weeks."
>
  <PageHero
    eyebrow="Hire Developers"
    title="Named engineers, not CVs,"
    highlight="in two weeks."
    sub="Tell us the skill and the shape of the team. You meet the people who will do the work before anything is signed."
  >
    <div style="display:flex;gap:14px;flex-wrap:wrap">
      <PillButton href="/contact" variant="primary" size="lg">Request profiles</PillButton>
      <PillButton href="/process" variant="ghost" size="lg" arrow={false}>How it works</PillButton>
    </div>
  </PageHero>

  <section class="section">
    <div class="container">
      <SectionHead
        eyebrow="Open Skills"
        title="Roles you can staff this month."
        lead="A pre-vetted pool of 500+ engineers across 50+ stacks. Availability is indicative — ask us for live profiles."
      />
      <div class="techx__tabs" data-roletabs>
        {roles.map((g, i) => (
          <button type="button" class:list={['techx__tab', { 'is-active': i === 0 }]} data-roletab={i}>{g.group}</button>
        ))}
      </div>
      {roles.map((g, i) => (
        <div style="display:grid;gap:10px" data-rolepanel={i} hidden={i !== 0}>
          {g.items.map((r) => <RoleCard {...r} />)}
        </div>
      ))}
    </div>
  </section>

  <section class="section section--band">
    <div class="container">
      <SectionHead
        eyebrow="Build Your Pod"
        title="Or take a whole team."
        lead="Individual engineers plug into your team. A pod arrives with its own product manager, QA and DevOps."
      />
      <PodConfigurator />
    </div>
  </section>

  <DarkBand>
    <div class="container">
      <SectionHead eyebrow="The Honest Comparison" title="Versus hiring it yourself." />
      <div class="reveal"><ComparisonTable columns={comparison.columns} rows={comparison.rows} highlight={2} /></div>
    </div>
  </DarkBand>

  <section class="section">
    <div class="container">
      <SectionHead
        eyebrow="Capability Map"
        title="Fifty-plus stacks, honestly graded."
        lead="Deep means we run centres of excellence. Core means production experience across multiple clients. Emerging means we are early but shipping."
      />
      <div class="reveal"><TechRadar domains={radar} /></div>
    </div>
  </section>

  <section class="section section--band text-center">
    <div class="container">
      <h2 class="h2">Tell us the skill. We'll send profiles.</h2>
      <p class="lead" style="margin-top:16px">Named engineers from a pre-vetted pool of 500+ — you meet the people who will do the work before anything is signed.</p>
      <div style="margin-top:28px;display:flex;justify-content:center">
        <PillButton href="/contact" variant="primary" size="lg">Request profiles</PillButton>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const tabs = document.querySelectorAll('[data-roletab]');
  const panels = document.querySelectorAll('[data-rolepanel]');
  tabs.forEach((t) => t.addEventListener('click', () => {
    const idx = t.dataset.roletab;
    tabs.forEach((x) => x.classList.toggle('is-active', x.dataset.roletab === idx));
    panels.forEach((p) => { p.hidden = p.dataset.rolepanel !== idx; });
  }));
</script>
