---
// Salesforce practice — /salesforce.
// Content lives in data/practicePages.js; the body is the shared PracticePage
// layout so this page matches the industry pages rather than the old template.
import BaseLayout from '../layouts/BaseLayout.astro';
import PracticePage from '../components/PracticePage.astro';
import { practicePages } from '../data/practicePages.js';
import { seo } from '../data/site.js';

const practice = practicePages.salesforce;
---

<BaseLayout title={seo.salesforce.title} description={seo.salesforce.description}>
  <link
    slot="head"
    rel="preload"
    as="image"
    type="image/webp"
    href={`${practice.img}-1600.webp`}
    imagesrcset={`${practice.img}-800.webp 800w, ${practice.img}-1600.webp 1600w`}
    imagesizes="100vw"
    fetchpriority="high"
  />
  <PracticePage
    practice={practice}
    listTitle="Salesforce clouds"
    listItems={practice.clouds}
    secondary={{ title: 'Industry verticals', items: practice.verticals }}
  />
</BaseLayout>
