# Huemot contact API — environment variables
# Copy to .env for local dev:  cp .env.example .env   (never commit .env)

# Server
PORT=8080

# SMTP credentials (e.g. Google Workspace, Zoho, SendGrid SMTP, etc.)
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password-or-app-password

# Where enquiries are delivered, and the visible From address
TO_EMAIL=info@huemot.com
FROM_EMAIL="Huemot Website <info@huemot.com>"
