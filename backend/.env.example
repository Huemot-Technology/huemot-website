# Huemot contact API — environment variables
# Copy to .env for local dev:  cp .env.example .env   (never commit .env)

# Server
PORT=8080

# Resend (https://resend.com) — email is sent over HTTPS, not SMTP,
# because cloud hosts (Render) block outbound SMTP ports.
# huemot.com must be a verified sending domain in your Resend account.
RESEND_API_KEY=re_your_api_key_here

# Where enquiries are delivered, and the visible From address.
# FROM_EMAIL must be an address on your Resend-verified domain.
TO_EMAIL=info@huemot.com
FROM_EMAIL="Huemot Website <noreply@huemot.com>"
